# Copy to .env and fill in. Never commit .env.

# --- Optional: normally entered in the dashboard ----------------------------------
# A value set here overrides the dashboard and makes that field read-only there.
# Leave these empty to enter them in the setup wizard instead (they are stored encrypted in the database).

# --- Claude -------------------------------------------------------
# Output of `claude setup-token` on a machine logged in to the Claude account.
CLAUDE_CODE_OAUTH_TOKEN=

# --- GitHub -------------------------------------------------------
# Fine-grained token limited to the target repos: Contents RW, Pull requests RW,
# Actions R, Commit statuses R, Metadata R. No administration permission.
GITHUB_TOKEN=
# Identity used for every commit.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# --- Jira REST mode (recommended: no Claude tokens) ---------------------------
# Atlassian Cloud site, for example https://yourco.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Jira Rovo MCP mode (optional) --------------------------------------------
# Usually connected with OAuth in Settings -> Connections. Or a scoped API token (Jira agent-interface scopes), used with JIRA_EMAIL.
JIRA_MCP_TOKEN=
# Default: https://mcp.atlassian.com/v2/mcp
JIRA_MCP_URL=
# Only when the sign-in sees several sites and JIRA_BASE_URL is not set.
JIRA_CLOUD_ID=
# Jira connector mode needs nothing here: run scripts/jira-connector-login.sh once.

# --- Dashboard and API --------------------------------------------------------
# Encrypts the tokens saved in the dashboard (AES-256-GCM). Required. Generate once: openssl rand -base64 32
# Back this file up separately from the database: without the key, saved tokens must be entered again.
ENCRYPTION_KEY=
# Optional. The admin password is normally created in the setup wizard (at least 12 characters).
# Setting it here overrides the wizard and disables password change in the dashboard.
DASHBOARD_PASSWORD=
# Optional. One-time code for the setup wizard. If empty, the API prints one in its log at start-up
# (docker compose logs api | grep 'setup code').
SETUP_CODE=
# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false
# Proxies in front of the API that add X-Forwarded-For: 1 is the dashboard's /api rewrite; use 2 behind a TLS reverse proxy too.
# TRUST_PROXY_HOPS=1
# Optional: run agent containers under gVisor (runsc) or Sysbox (sysbox-runc) once installed on the Docker host. Empty = Docker's default.
# AGENT_RUNTIME=
# Host names the dashboard answers to besides localhost, comma-separated (the public name behind a TLS reverse proxy).
# ALLOWED_HOSTS=
# Address the dashboard port is published on.
DASHBOARD_BIND=127.0.0.1

# --- Database (required) -------------------------------------------------------
# DATABASE_URL is built from this in docker-compose.yml.
POSTGRES_PASSWORD=
# For local development outside Compose (npm run dev), point at the Compose postgres:
# DATABASE_URL=postgresql://sdlc:<POSTGRES_PASSWORD>@localhost:5432/sdlc

# --- Storage (required) ---------------------------------------------------------
# Absolute host path for mirrors, workspaces, runs and logs.
DATA_DIR=

# --- Agent containers (optional) ------------------------------------------------
# Agent image tag. Leave unset: a source build uses sdlc-agent/agent:latest, a release install uses the published image for SDLC_VERSION.
# AGENT_IMAGE=
# Limits per agent container.
AGENT_MEMORY=4g
AGENT_CPUS=2

# --- Logging (optional) ----------------------------------------------------------
# pino level: trace, debug, info, warn, error
LOG_LEVEL=info

# --- Release install (optional) ---------------------------------------------------
# Used only by deploy/docker-compose.yml (the compose file inside a release bundle); ignored when you run from source.
# The release to run, without the leading v (for example 0.0.0).
SDLC_VERSION=
SDLC_REGISTRY=ghcr.io/pjx16
# Docker socket path on the host, if it is not /var/run/docker.sock (Colima, OrbStack). Used by deploy/docker-compose.yml.
# DOCKER_SOCK=
